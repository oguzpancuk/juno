{
  "expo": {
    "name": "stardate",
    "slug": "stardate",
    "version": "0.0.1",
    "scheme": "stardate",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oguzpancuk.stardate"
    },
    "android": {
      "package": "com.oguzpancuk.stardate",
      "adaptiveIcon": {
        "backgroundColor": "#0b0b1a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0b0b1a"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "stardate, yak\u0131n\u0131ndaki ki\u015fileri g\u00f6stermek i\u00e7in konumunu bir kez okur. Konum sadece mesafe olarak payla\u015f\u0131l\u0131r, koordinat\u0131n kimseye g\u00f6sterilmez."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    }
  }
}
