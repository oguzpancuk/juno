{
  "expo": {
    "name": "stardate",
    "slug": "stardate",
    "version": "0.0.1",
    "scheme": "stardate",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oguzpancuk.stardate"
    },
    "android": {
      "package": "com.oguzpancuk.stardate",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0b0b1a"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "stardate, yakınındaki kişileri göstermek için konumunu bir kez okur. Konum sadece mesafe olarak paylaşılır, koordinatın kimseye gösterilmez."
        }
      ]
    ]
  }
}
