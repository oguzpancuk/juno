{
  // npm hoists wrangler to the repo root, so the path wrangler writes
  // here resolves to nothing and editors validate nothing.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "juno",
  "compatibility_date": "2026-09-16",
  "observability": {
    "enabled": true,
  },
  // The public address. A custom domain is a Workers-side binding, not a
  // DNS record anyone writes by hand: Cloudflare creates and owns the
  // record for it, which is why the zone had to move here first — a
  // Worker cannot take a hostname in a zone Cloudflare does not serve.
  "routes": [
    {
      "pattern": "www.juno-dating.com",
      "custom_domain": true,
    },
    // The bare domain too: it is what people type, and left unbound it
    // resolves to nothing at all rather than to the site.
    {
      "pattern": "juno-dating.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "dist",
    // `app.json` asks for `output: "single"`, so every route is one page
    // and the router does the rest. This is what tells the host to answer
    // /legal with index.html instead of a 404 — and /legal is the one URL
    // that has to work, being the public home of the privacy notice.
    //
    // A `_redirects` file with the usual `/* /index.html 200` was tried
    // first and is what every other static host wants; Cloudflare rejects
    // it as an infinite loop (serving /index.html matches /* again) and
    // refuses to deploy. This is the setting that replaces it.
    "not_found_handling": "single-page-application",
  },
}
