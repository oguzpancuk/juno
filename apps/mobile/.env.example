# Copy to .env (gitignored). Values from `npx supabase status -o env`
# for local work; the hosted project's URL and anon key for TestFlight.
# The anon key is public by design; RLS is the boundary.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Google sign-in. Both are public client IDs, not secrets — the Google
# client SECRET belongs only in the Supabase dashboard and must never
# appear here. Leave them out and the app simply has no Google button;
# Apple on iOS needs nothing here, its client is the bundle identifier.
# How to create them: docs/auth-setup.md.
#
# The WEB client of the Google Cloud project. It is the audience Supabase
# checks, so it is required on every platform, iOS included.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<id>.apps.googleusercontent.com
# The iOS client. `app.config.ts` also derives the URL scheme iOS returns
# on from it, so a dev build made without it has no Google button even if
# this is set later.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<id>.apps.googleusercontent.com

# Apple on the web: the Services ID (not the App ID, and never the client
# secret JWT or the .p8 key). The site does not send it anywhere, Supabase
# does; it only decides whether the web shows the Apple button. Leave it
# out and the web has no Apple button. docs/auth-setup.md, 3b. Left
# commented: set, it shows the button, and until 3b is done (and on the
# local stack, which has no Apple provider) that button only reaches an
# error page.
# EXPO_PUBLIC_APPLE_SERVICES_ID=com.oguzpancuk.juno.web

# Crash reports (docs/adr/0016-crash-reporting.md). The DSN of a Sentry
# project in the EU region (…ingest.de.sentry.io). The app reports
# nothing with any other, and `npm run deploy` refuses it. It is public by
# design, it can only send. The Sentry AUTH TOKEN
# is a secret and never goes here. Leave it out and nothing is reported.
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
#
# Opens /crash-test, which crashes on purpose, for the ROADMAP check; its
# reports go to the "crash-test" environment. Only in a build made for
# that check: `npm run deploy` refuses it.
# EXPO_PUBLIC_CRASH_TEST=1
